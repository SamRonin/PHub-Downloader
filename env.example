# ==== Required ====
BOT_TOKEN=123456:ABC-your-telegram-bot-token
PIXELDRAIN_API_KEY=your-pixeldrain-api-key
ADMIN_IDS=123456789,987654321

# ==== Optional (defaults shown) ====
# DB_PATH=/data/phdownloader.db
# TEMP_DIR=/data/tmp
# DAILY_QUOTA_FREE_MB=500
# DAILY_QUOTA_PRO_MB=2048
# SPEED_LIMIT_FREE_MBPS=2
# TELEGRAM_LIMIT_MB=50
# PX_DELETE_MINUTES=30
# REFERRALS_FOR_PRO=2
# PRO_DAYS=30
# MAX_CONCURRENT_DOWNLOADS=3

# ==== PornHub access ====
# If PornHub redirects/blocks the Railway egress IP ("Redirection detected;
# the video may be deleted or require login"), route ALL PornHub traffic
# through a proxy on a clean IP:
#   PH_PROXY=http://user:pass@host:port     (or socks5://host:port)
# Free/cheap datacenter proxies usually work; a residential proxy is the
# most reliable. Every new Railway deploy may also get a different (unflagged)
# egress IP automatically — check the "Egress IP" line in the startup logs.
